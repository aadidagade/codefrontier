# ==============================================================================
# Production Multi-Stage Dockerfile for Frontend Client (React 19 + Nginx)
# ==============================================================================

# STAGE 1: Build static assets via Vite
FROM node:20-alpine as builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# STAGE 2: Lightweight Alpine Nginx reverse proxy & static file server
FROM nginx:alpine-slim

# Copy compiled production bundle from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy production Nginx reverse proxy configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
